DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_ID=
DISCORD_PARTICIPANT_ROLE_ID=

# Optional bootstrap role settings
BOOTSTRAP_ADMIN_ROLE_NAME=Admin
BOOTSTRAP_PARTICIPANT_ROLE_NAME=Participant
BOOTSTRAP_ENV_FILE=.env

PG_CONNECTION_STRING=postgres://postgres:postgres@localhost:5432/discord_ai

# OpenClaw transport: http or cli
OPENCLAW_TRANSPORT=http

# HTTP mode
OPENCLAW_BASE_URL=https://your-openclaw.example.com
OPENCLAW_OAUTH_BEARER_TOKEN=

OPENCLAW_OAUTH_BEARER_TOKEN=

# CLI mode
# The bot will send one JSON request to stdin and expects one JSON object on stdout.
OPENCLAW_CLI_COMMAND=
OPENCLAW_CLI_ARGS_JSON=[]
OPENCLAW_CLI_CWD=

OPENCLAW_TIMEOUT_MS=30000
OPENCLAW_RETRY_ATTEMPTS=3
OPENCLAW_RETRY_BASE_DELAY_MS=700
OPENCLAW_RETRY_MAX_DELAY_MS=6000

MACRO_FORUM_CHANNEL_ID=
KOR_FORUM_CHANNEL_ID=
EX_FORUM_CHANNEL_ID=
COIN_FORUM_CHANNEL_ID=

MACRO_SUMMARY_CHANNEL_ID=
KOR_SUMMARY_CHANNEL_ID=
EX_SUMMARY_CHANNEL_ID=
COIN_SUMMARY_CHANNEL_ID=

# Optional if not using bootstrap script
MACRO_QUESTION_CHANNEL_ID=
KOR_QUESTION_CHANNEL_ID=
EX_QUESTION_CHANNEL_ID=
COIN_QUESTION_CHANNEL_ID=

ROLLOVER_MESSAGE_THRESHOLD=120
SUMMARY_MAX_MESSAGES=2000

ANALYSIS_TURN_DELAY_MS=2000
ANALYSIS_SKIP_FAILED_TURN=true
ANALYSIS_MAX_CONCURRENCY=2
ANALYSIS_COMMAND_COOLDOWN_SEC=30
ANALYSIS_RESUME_ON_START=true

ENABLE_SETUP_CHECKS=true
